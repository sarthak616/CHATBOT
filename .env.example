# ============================================
#   NEXUS SEARCH — Environment Variables
# ============================================
# Copy this file to server/.env and fill in values

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/nexus-search
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/nexus-search

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# --- Redis (for caching & rate limiting) ---
REDIS_URL=redis://localhost:6379
# For Upstash: rediss://<user>:<pass>@<host>.upstash.io:6380

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# --- SerpAPI (Web Search) ---
SERPAPI_KEY=your-serpapi-key
# Get yours at: https://serpapi.com/

# Alternative: Bing Search API
# BING_SEARCH_KEY=your-bing-key
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# --- Pinecone (Vector DB for file RAG) ---
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX=nexus-search-embeddings
# Get yours at: https://www.pinecone.io/

# --- File Uploads ---
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# --- Frontend URL (for CORS) ---
CLIENT_URL=http://localhost:3000
# Production: https://nexus-search.vercel.app

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SEARCH_RATE_LIMIT_PER_HOUR=20
